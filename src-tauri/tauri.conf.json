{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Uninstall a Program (Bulk Edition)",
  "version": "0.1.2",
  "identifier": "io.github.taylorivanoff.uninstall-a-program",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Uninstall a Program (Bulk Edition)",
        "width": 1000,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Taylor Ivanoff",
    "shortDescription": "Uninstall a program — or many at once (bulk edition)",
    "longDescription": "Uninstall a Program (Bulk Edition) is a fast bulk Windows program remover. Search and sort installed Win32/MSI apps, multi-select, and uninstall many programs in one run with quiet MSI support, safety guards, live progress, and administrator elevation.",
    "category": "Utility",
    "copyright": "Copyright © Taylor Ivanoff",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
